#Check for human associated taxa in the ITS rep-seqs using ClassifyITS

#Download the contaminant reference file from the github repository
wget -O potential_contamination.fasta \
  "https://raw.githubusercontent.com/qmoon11/ClassifyITS/main/inst/extdata/potential_contamination.fasta"


#################################################################################
Download BLAST
#################################################################################
wget https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/LATEST/ncbi-blast-2.17.0+-x64-linux.tar.gz
tar -xzf ncbi-blast-2.17.0+-x64-linux.tar.gz
export PATH=$PWD/ncbi-blast-2.17.0+/bin:$PATH


#make into a database
makeblastdb \
    -in potential_contamination.fasta \
    -dbtype nucl \
    -out contam_db

#Run BLASTn
blastn \
    -task megablast \
    -query rep-seqs/dna-sequences_ITS_SSBS.fasta \
    -db contam_db \
    -out blast_contam_SSBS_ITS.tsv \
    -word_size 28 \
    -reward 1 \
    -penalty -2 \
    -gapopen 0 \
    -gapextend 2 \
    -max_target_seqs 10 \
    -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore stitle" \
    -num_threads 8


  #There are no matches greater than 96% identify and alingment more than 100 bp. We can be confident none of the contaminant are in final OTUs.

